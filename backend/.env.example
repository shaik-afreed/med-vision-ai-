# Copy this file to .env and fill in real values for your environment.
# .env itself is gitignored and must never be committed.

ENVIRONMENT=development

DATABASE_URL=sqlite:///./medivision.db

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=changeme-generate-a-real-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

UPLOAD_DIR=uploads/xrays
MAX_UPLOAD_SIZE_MB=10

MODEL_VERSION=mobilenetv2-finetuned-v1

# X-ray chatbot. Optional - without any of this it answers common
# questions with built-in answers.
#
# Option 1 (works on a deployed server too): an NVIDIA-hosted model.
# Create a key at https://build.nvidia.com and paste it in your own
# backend/.env (never in this file). Questions and the minimal result data
# are sent to NVIDIA; patient name/phone/address are not.
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b
#
# Option 2: a local open-source model served by Ollama on this machine
# (nothing leaves the computer; only works where Ollama can run).
#   1. Install Ollama from https://ollama.com
#   2. ollama pull qwen2.5:7b     (stronger, ~4.7 GB)
#      or ollama pull llama3.2:3b (faster, ~2 GB) and set LOCAL_LLM_MODEL
LOCAL_LLM_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen2.5:7b
